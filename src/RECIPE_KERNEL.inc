typedef struct
{
	WEB		*NEURAL_WEB;
	RECIPE	*CURRENT_RECIPE;
	int		AREA_INDEX;
	int32_t	ROW_STRIDE;
} RECIPE_KERNEL;

static void
	RECIPE_LOCATE(
		RECIPE_KERNEL *RECIPE_STATE, int OPERATION_INDEX, int USE_GRADIENT,
		int *BASE_REGISTER, int32_t *DISPLACEMENT
	)
{
	RECIPE_OPERATION	*OPERATION =
		&RECIPE_STATE->CURRENT_RECIPE->OPERATIONS[OPERATION_INDEX];

	if (OPERATION->LOCATION == LOCATION_INPUT)
	{
		*BASE_REGISTER = RSI;
		*DISPLACEMENT = (int32_t)(USE_GRADIENT ? LAYER_NORMALIZED_GRADIENT(
			RECIPE_STATE->NEURAL_WEB,
			RECIPE_STATE->AREA_INDEX
			)
			: KERNEL_LAYER_NORMALIZED(
				RECIPE_STATE->NEURAL_WEB,
				RECIPE_STATE->AREA_INDEX
				));
		return ;
	}

	if (OPERATION->LOCATION == LOCATION_RESIDUAL)
	{
		*BASE_REGISTER = RSI;
		*DISPLACEMENT =
			(int32_t)(USE_GRADIENT ? LAYER_RESIDUAL_GRADIENT(
				RECIPE_STATE->NEURAL_WEB,
				RECIPE_STATE->AREA_INDEX + 1
				)
				: KERNEL_LAYER_RESIDUAL(
					RECIPE_STATE->NEURAL_WEB,
					RECIPE_STATE->AREA_INDEX + 1
					));
		return ;
	}

	*BASE_REGISTER = RDI;
	*DISPLACEMENT = (int32_t)((USE_GRADIENT ? ACTIVATION_PLANE : 0) +
		OPERATION->VALUE_OFFSET);
}

static MEMORY_OPERAND
	RECIPE_VALUE_OPERAND(
		RECIPE_KERNEL *RECIPE_STATE, int OPERATION_INDEX, int USE_GRADIENT,
		int INDEX_REGISTER, int32_t EXTRA_OFFSET
	)
{
	int		BASE_REGISTER;
	int32_t	DISPLACEMENT;

	RECIPE_LOCATE(
		RECIPE_STATE, OPERATION_INDEX, USE_GRADIENT, &BASE_REGISTER,
		&DISPLACEMENT
	);

	return (
		OPERAND_AT(BASE_REGISTER, INDEX_REGISTER, DISPLACEMENT + EXTRA_OFFSET)
	);
}

static void
	RECIPE_ROW_POINTERS(ASSEMBLER *ASSEMBLY, RECIPE_KERNEL *RECIPE_STATE)
{
	ROW_POINTER(
		ASSEMBLY, RSI, RECIPE_STATE->NEURAL_WEB->CONFIGURATION.DIMENSION * 4
	);
	MULTIPLY_IMMEDIATE(ASSEMBLY, RDI, RAX, RECIPE_STATE->ROW_STRIDE);
	ADD_REGISTER(ASSEMBLY, RDI, R14);
	ADD_FROM_MEMORY(ASSEMBLY, RDI, STATE_FIELD(NEURON_ACTIVATION_OFFSET));
}

static void
	VECTOR_SIGMOID(ASSEMBLER *ASSEMBLY, int VALUE_REGISTER)
{
	ZERO_VECTOR(ASSEMBLY, 1);
	VECTOR_MATH(
		ASSEMBLY, 1, OPCODE_SUBTRACT, VALUE_REGISTER, 1, VALUE_REGISTER
	);
	VECTOR_EXPONENTIAL(ASSEMBLY, 1, VALUE_REGISTER, 2, 3);
	VECTOR_MATH_MEMORY(
		ASSEMBLY, 1, OPCODE_ADD, VALUE_REGISTER, VALUE_REGISTER,
		STATE_CONSTANT(CONSTANT_ONE)
	);
	VECTOR_LOAD(ASSEMBLY, 1, 1, STATE_CONSTANT(CONSTANT_ONE));
	VECTOR_MATH(ASSEMBLY, 1, OPCODE_DIVIDE, VALUE_REGISTER, 1, VALUE_REGISTER);
}

static void
	GELU_GATE(ASSEMBLER *ASSEMBLY, int RESULT_REGISTER, int INPUT_REGISTER)
{
	VECTOR_MATH(
		ASSEMBLY, 1, OPCODE_MULTIPLY, RESULT_REGISTER, INPUT_REGISTER,
		INPUT_REGISTER
	);
	VECTOR_MATH(
		ASSEMBLY, 1, OPCODE_MULTIPLY, RESULT_REGISTER, RESULT_REGISTER,
		INPUT_REGISTER
	);
	VECTOR_MATH_MEMORY(
		ASSEMBLY, 1, OPCODE_MULTIPLY, RESULT_REGISTER, RESULT_REGISTER,
		STATE_CONSTANT(CONSTANT_GELU_CUBIC)
	);
	VECTOR_MATH(
		ASSEMBLY, 1, OPCODE_ADD, RESULT_REGISTER, RESULT_REGISTER,
		INPUT_REGISTER
	);
	VECTOR_MATH_MEMORY(
		ASSEMBLY, 1, OPCODE_MULTIPLY, RESULT_REGISTER, RESULT_REGISTER,
		STATE_CONSTANT(CONSTANT_GELU_SCALE)
	);
	VECTOR_SIGMOID(ASSEMBLY, RESULT_REGISTER);
}

typedef struct
{
	RECIPE_KERNEL	*RECIPE_STATE;
	int				OPERATION_INDEX;
	int32_t			PARAMETER_OFFSET;
} ELEMENT_LAYOUT;

static void
	ACCUMULATE_TO_MEMORY(
		ASSEMBLER *ASSEMBLY, int VALUE_REGISTER, MEMORY_OPERAND TARGET_MEMORY
	)
{
	VECTOR_MATH_MEMORY(
		ASSEMBLY, 1, OPCODE_ADD, VALUE_REGISTER, VALUE_REGISTER, TARGET_MEMORY
	);
	VECTOR_STORE(ASSEMBLY, 1, TARGET_MEMORY, VALUE_REGISTER);
}

static void
	ELEMENT_FORWARD_CHUNK(
		ASSEMBLER *ASSEMBLY, void *USER_DATA, int INDEX_REGISTER,
		int32_t CHUNK_OFFSET
	)
{
	ELEMENT_LAYOUT		*LAYOUT = USER_DATA;
	RECIPE_KERNEL		*RECIPE_STATE = LAYOUT->RECIPE_STATE;
	RECIPE_OPERATION	*OPERATION =
		&RECIPE_STATE->CURRENT_RECIPE->OPERATIONS[LAYOUT->OPERATION_INDEX];

	if (OPERATION->OPERATION == RECIPE_OUTPUT)
	{
		VECTOR_LOAD(
			ASSEMBLY, 1, 0,
			OPERAND_AT(
				RSI, INDEX_REGISTER,
				(int32_t)KERNEL_LAYER_RESIDUAL(
					RECIPE_STATE->NEURAL_WEB, RECIPE_STATE->AREA_INDEX + 1
				) + CHUNK_OFFSET
			)
		);
		VECTOR_MATH_MEMORY(
			ASSEMBLY, 1, OPCODE_ADD, 0, 0,
			RECIPE_VALUE_OPERAND(
				RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
				CHUNK_OFFSET
			)
		);
		VECTOR_STORE(
			ASSEMBLY, 1,
			OPERAND_AT(
				RSI, INDEX_REGISTER,
				(int32_t)KERNEL_LAYER_RESIDUAL(
					RECIPE_STATE->NEURAL_WEB, RECIPE_STATE->AREA_INDEX + 1
				) + CHUNK_OFFSET
			),
			0
		);
		return ;
	}

	if (OPERATION->OPERATION == RECIPE_SOFTMAX)
	{
		VECTOR_LOAD(
			ASSEMBLY, 1, 0,
			RECIPE_VALUE_OPERAND(
				RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
				CHUNK_OFFSET
			)
		);
		VECTOR_STORE(
			ASSEMBLY, 1,
			RECIPE_VALUE_OPERAND(
				RECIPE_STATE, LAYOUT->OPERATION_INDEX, 0, INDEX_REGISTER,
				CHUNK_OFFSET
			),
			0
		);
		return ;
	}

	VECTOR_LOAD(
		ASSEMBLY, 1, 0,
		RECIPE_VALUE_OPERAND(
			RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
			CHUNK_OFFSET
		)
	);

	switch (OPERATION->OPERATION)
	{
		case RECIPE_ADD:
		{
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_ADD, 0, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
		}
		break ;
		case RECIPE_SUBTRACT:
		{
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_SUBTRACT, 0, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
		}
		break ;
		case RECIPE_MULTIPLY:
		{
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
		}
		break ;
		case RECIPE_ADD_PARAMETER:
		{
			WEIGHT_MATH(
				ASSEMBLY, OPCODE_ADD, 0, 0,
				WEIGHT_OPERAND(
					R12, INDEX_REGISTER, LAYOUT->PARAMETER_OFFSET + CHUNK_OFFSET
				)
			);
		}
		break ;
		case RECIPE_MULTIPLY_PARAMETER:
		{
			WEIGHT_MATH(
				ASSEMBLY, OPCODE_MULTIPLY, 0, 0,
				WEIGHT_OPERAND(
					R12, INDEX_REGISTER, LAYOUT->PARAMETER_OFFSET + CHUNK_OFFSET
				)
			);
		}
		break ;
		case RECIPE_RELU:
		{
			ZERO_VECTOR(ASSEMBLY, 1);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MAXIMUM, 0, 0, 1);
		}
		break ;
		case RECIPE_SIGMOID:
		{
			VECTOR_SIGMOID(ASSEMBLY, 0);
		}
		break ;
		case RECIPE_SILU:
		{
			VECTOR_MOVE(ASSEMBLY, 1, 4, 0);
			VECTOR_SIGMOID(ASSEMBLY, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 0, 4);
		}
		break ;
		case RECIPE_TANH:
		{
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_ADD, 0, 0, 0);
			VECTOR_SIGMOID(ASSEMBLY, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_ADD, 0, 0, 0);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_SUBTRACT, 0, 0, STATE_CONSTANT(CONSTANT_ONE)
			);
		}
		break ;
		case RECIPE_GELU:
		{
			VECTOR_MOVE(ASSEMBLY, 1, 4, 0);
			GELU_GATE(ASSEMBLY, 0, 4);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 0, 4);
		}
		break ;
		case RECIPE_SCALE:
		{
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 0, 6);
		}
		break ;
		default:
			break ;
	}

	VECTOR_STORE(
		ASSEMBLY, 1,
		RECIPE_VALUE_OPERAND(
			RECIPE_STATE, LAYOUT->OPERATION_INDEX, 0, INDEX_REGISTER,
			CHUNK_OFFSET
		),
		0
	);
}

static void
	ELEMENT_BACKWARD_CHUNK(
		ASSEMBLER *ASSEMBLY, void *USER_DATA, int INDEX_REGISTER,
		int32_t CHUNK_OFFSET
	)
{
	ELEMENT_LAYOUT		*LAYOUT = USER_DATA;
	RECIPE_KERNEL		*RECIPE_STATE = LAYOUT->RECIPE_STATE;
	RECIPE_OPERATION	*OPERATION =
		&RECIPE_STATE->CURRENT_RECIPE->OPERATIONS[LAYOUT->OPERATION_INDEX];
	int32_t				GRADIENT_PLANE = (int32_t)PARAMETER_PLANE;

	if (OPERATION->OPERATION == RECIPE_OUTPUT)
	{
		VECTOR_LOAD(
			ASSEMBLY, 1, 5,
			OPERAND_AT(
				RSI, INDEX_REGISTER,
				(int32_t)LAYER_RESIDUAL_GRADIENT(
					RECIPE_STATE->NEURAL_WEB, RECIPE_STATE->AREA_INDEX + 1
				) + CHUNK_OFFSET
			)
		);
		ACCUMULATE_TO_MEMORY(
			ASSEMBLY, 5,
			RECIPE_VALUE_OPERAND(
				RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
				CHUNK_OFFSET
			)
		);
		return ;
	}

	if (
		OPERATION->OPERATION == RECIPE_SUM ||
		OPERATION->OPERATION == RECIPE_DOT_PRODUCT
	)
	{
		if (OPERATION->OPERATION == RECIPE_DOT_PRODUCT)
		{
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 6,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 6,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
		}
		else
		{
			VECTOR_MOVE(ASSEMBLY, 1, 0, 6);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
		}

		return ;
	}

	VECTOR_LOAD(
		ASSEMBLY, 1, 5,
		RECIPE_VALUE_OPERAND(
			RECIPE_STATE, LAYOUT->OPERATION_INDEX, 1, INDEX_REGISTER,
			CHUNK_OFFSET
		)
	);

	switch (OPERATION->OPERATION)
	{
		case RECIPE_ADD:
		{
			VECTOR_MOVE(ASSEMBLY, 1, 0, 5);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_MOVE(ASSEMBLY, 1, 0, 5);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			return ;
		}
		case RECIPE_SUBTRACT:
		{
			VECTOR_MOVE(ASSEMBLY, 1, 0, 5);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_LOAD(
				ASSEMBLY, 1, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_SUBTRACT, 0, 0, 5);
			VECTOR_STORE(
				ASSEMBLY, 1,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				),
				0
			);
			return ;
		}
		case RECIPE_MULTIPLY:
		{
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 5,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 5,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->SECOND_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			return ;
		}
		case RECIPE_ADD_PARAMETER:
		{
			VECTOR_MOVE(ASSEMBLY, 1, 0, 5);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 5,
				OPERAND_AT(
					R12, INDEX_REGISTER,
					GRADIENT_PLANE + LAYOUT->PARAMETER_OFFSET + CHUNK_OFFSET
				)
			);
			return ;
		}
		case RECIPE_MULTIPLY_PARAMETER:
		{
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 5,
				OPERAND_AT(
					R12, INDEX_REGISTER, LAYOUT->PARAMETER_OFFSET + CHUNK_OFFSET
				)
			);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 5,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				OPERAND_AT(
					R12, INDEX_REGISTER,
					GRADIENT_PLANE + LAYOUT->PARAMETER_OFFSET + CHUNK_OFFSET
				)
			);
			return ;
		}
		case RECIPE_RELU:
		{
			VECTOR_LOAD(
				ASSEMBLY, 1, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, LAYOUT->OPERATION_INDEX, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			ZERO_VECTOR(ASSEMBLY, 1);
			VECTOR_COMPARE_MASK(ASSEMBLY, 1, 0, 0, 1, 0X1E);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_AND, 5, 5, 0);
		}
		break ;
		case RECIPE_SIGMOID:
		{
			VECTOR_LOAD(
				ASSEMBLY, 1, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, LAYOUT->OPERATION_INDEX, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_LOAD(ASSEMBLY, 1, 1, STATE_CONSTANT(CONSTANT_ONE));
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_SUBTRACT, 1, 1, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 0, 1);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 5, 5, 0);
		}
		break ;
		case RECIPE_SILU:
		{
			VECTOR_LOAD(
				ASSEMBLY, 1, 4,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_MOVE(ASSEMBLY, 1, 0, 4);
			VECTOR_SIGMOID(ASSEMBLY, 0);
			VECTOR_LOAD(ASSEMBLY, 1, 1, STATE_CONSTANT(CONSTANT_ONE));
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_SUBTRACT, 1, 1, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 1, 1, 4);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_ADD, 1, 1, STATE_CONSTANT(CONSTANT_ONE)
			);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 1, 1, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 5, 5, 1);
		}
		break ;
		case RECIPE_TANH:
		{
			VECTOR_LOAD(
				ASSEMBLY, 1, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, LAYOUT->OPERATION_INDEX, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 0, 0);
			VECTOR_LOAD(ASSEMBLY, 1, 1, STATE_CONSTANT(CONSTANT_ONE));
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_SUBTRACT, 1, 1, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 5, 5, 1);
		}
		break ;
		case RECIPE_GELU:
		{
			VECTOR_LOAD(
				ASSEMBLY, 1, 4,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			GELU_GATE(ASSEMBLY, 0, 4);
			VECTOR_LOAD(ASSEMBLY, 1, 1, STATE_CONSTANT(CONSTANT_ONE));
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_SUBTRACT, 1, 1, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 1, 1, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 1, 1, 4);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 1, 1,
				STATE_CONSTANT(CONSTANT_GELU_SCALE)
			);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 7, 4, 4);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 7, 7,
				STATE_CONSTANT(CONSTANT_GELU_CUBIC)
			);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_ADD, 2, 7, 7);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_ADD, 7, 2, 7);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_ADD, 7, 7, STATE_CONSTANT(CONSTANT_ONE)
			);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 1, 1, 7);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_ADD, 1, 1, 0);
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 5, 5, 1);
		}
		break ;
		case RECIPE_SCALE:
		{
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_MULTIPLY, 0, 5, 6);
			ACCUMULATE_TO_MEMORY(
				ASSEMBLY, 0,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			MULTIPLY_ADD_MEMORY(
				ASSEMBLY, 1, 7, 5,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OPERATION->FIRST_INPUT, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
			return ;
		}
		case RECIPE_SOFTMAX:
		{
			VECTOR_MATH(ASSEMBLY, 1, OPCODE_SUBTRACT, 5, 5, 6);
			VECTOR_MATH_MEMORY(
				ASSEMBLY, 1, OPCODE_MULTIPLY, 5, 5,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, LAYOUT->OPERATION_INDEX, 0, INDEX_REGISTER,
					CHUNK_OFFSET
				)
			);
		}
		break ;
		default:
			break ;
	}

	ACCUMULATE_TO_MEMORY(
		ASSEMBLY, 5,
		RECIPE_VALUE_OPERAND(
			RECIPE_STATE, OPERATION->FIRST_INPUT, 1, INDEX_REGISTER,
			CHUNK_OFFSET
		)
	);
}

typedef struct
{
	RECIPE_KERNEL	*RECIPE_STATE;
	int				OPERATION_INDEX;
} SUM_LAYOUT;

static void
	SUM_CHUNK(
		ASSEMBLER *ASSEMBLY, void *USER_DATA, int INDEX_REGISTER,
		int32_t CHUNK_OFFSET
	)
{
	SUM_LAYOUT	*LAYOUT = USER_DATA;

	VECTOR_MATH_MEMORY(
		ASSEMBLY, 1, OPCODE_ADD, 0, 0,
		RECIPE_VALUE_OPERAND(
			LAYOUT->RECIPE_STATE,
			LAYOUT->RECIPE_STATE->CURRENT_RECIPE
				->OPERATIONS[LAYOUT->OPERATION_INDEX]
				.FIRST_INPUT,
			0, INDEX_REGISTER, CHUNK_OFFSET
		)
	);
}

static void
	CLEAR_GRADIENT_CHUNK(
		ASSEMBLER *ASSEMBLY, void *USER_DATA, int INDEX_REGISTER,
		int32_t CHUNK_OFFSET
	)
{
	(void)USER_DATA;
	VECTOR_STORE(
		ASSEMBLY, 1,
		OPERAND_AT(
			RDI, INDEX_REGISTER, (int32_t)ACTIVATION_PLANE + CHUNK_OFFSET
		),
		15
	);
}

static void
	RECIPE_TRANSPOSED_VECTOR(
		ASSEMBLER *ASSEMBLY, RECIPE_KERNEL *RECIPE_STATE, int OUTPUT_COUNT,
		int INPUT_COUNT, int32_t PARAMETER_OFFSET, int INPUT_BASE,
		int32_t INPUT_DISPLACEMENT, int OUTPUT_OPERATION, int OUTPUT_GRADIENT,
		int SHOULD_ACCUMULATE
	)
{
	int	GROUP_START;

	for (GROUP_START = 0; GROUP_START < OUTPUT_COUNT / 8; GROUP_START += 12)
	{
		int	GROUP_COUNT;

		if (OUTPUT_COUNT / 8 - GROUP_START < 12)
			GROUP_COUNT = OUTPUT_COUNT / 8 - GROUP_START;
		else
			GROUP_COUNT = 12;

		int	LOOP_TOP = ASSEMBLER_NEW_LABEL(ASSEMBLY);
		int	SKIP_LABEL = ASSEMBLER_NEW_LABEL(ASSEMBLY);
		int	VECTOR_INDEX;

		for (VECTOR_INDEX = 0; VECTOR_INDEX < GROUP_COUNT; VECTOR_INDEX++)
		{
			if (SHOULD_ACCUMULATE)
				VECTOR_LOAD(
					ASSEMBLY, 1, VECTOR_INDEX,
					RECIPE_VALUE_OPERAND(
						RECIPE_STATE, OUTPUT_OPERATION, OUTPUT_GRADIENT, -1,
						32 * (GROUP_START + VECTOR_INDEX)
					)
				);
			else
				ZERO_VECTOR(ASSEMBLY, VECTOR_INDEX);
		}

		LOAD_ADDRESS(ASSEMBLY, R8, WEIGHT_OPERAND(R12, -1, PARAMETER_OFFSET));
		MOVE_IMMEDIATE(ASSEMBLY, RCX, 0);
		ZERO_VECTOR(ASSEMBLY, 14);
		ASSEMBLER_BIND_LABEL(ASSEMBLY, LOOP_TOP);
		SCALAR_LOAD(
			ASSEMBLY, 12, MEMORY_INDEXED(INPUT_BASE, RCX, 4, INPUT_DISPLACEMENT)
		);
		SCALAR_COMPARE(ASSEMBLY, 12, 14);
		BRANCH_TO_LABEL(ASSEMBLY, CC_E, SKIP_LABEL);
		BROADCAST_REGISTER(ASSEMBLY, 1, 12, 12);

		for (VECTOR_INDEX = 0; VECTOR_INDEX < GROUP_COUNT; VECTOR_INDEX++)
			MULTIPLY_ADD_WEIGHTS(
				ASSEMBLY, VECTOR_INDEX, 12,
				WEIGHT_OPERAND(R8, -1, 32 * (GROUP_START + VECTOR_INDEX))
			);

		ASSEMBLER_BIND_LABEL(ASSEMBLY, SKIP_LABEL);
		ADD_IMMEDIATE(
			ASSEMBLY, R8, HALF_WEIGHTS ? OUTPUT_COUNT * 2 : OUTPUT_COUNT * 4
		);
		ADD_IMMEDIATE(ASSEMBLY, RCX, 1);
		COMPARE_IMMEDIATE(ASSEMBLY, RCX, INPUT_COUNT);
		BRANCH_TO_LABEL(ASSEMBLY, CC_L, LOOP_TOP);

		for (VECTOR_INDEX = 0; VECTOR_INDEX < GROUP_COUNT; VECTOR_INDEX++)
			VECTOR_STORE(
				ASSEMBLY, 1,
				RECIPE_VALUE_OPERAND(
					RECIPE_STATE, OUTPUT_OPERATION, OUTPUT_GRADIENT, -1,
					32 * (GROUP_START + VECTOR_INDEX)
				),
				VECTOR_INDEX
			);
	}
}

static void
	EMIT_MATRIX_VECTOR(
		ASSEMBLER *ASSEMBLY, RECIPE_KERNEL *RECIPE_STATE, int ROW_COUNT,
		int COLUMN_COUNT, int32_t PARAMETER_OFFSET, int INPUT_BASE,
		int32_t INPUT_DISPLACEMENT, int OUTPUT_BASE,
		int32_t OUTPUT_DISPLACEMENT, int SHOULD_ACCUMULATE
	)
{
	int	LOOP_TOP = ASSEMBLER_NEW_LABEL(ASSEMBLY);

	LOAD_ADDRESS(ASSEMBLY, R8, WEIGHT_OPERAND(R12, -1, PARAMETER_OFFSET));
	MOVE_IMMEDIATE(ASSEMBLY, RCX, 0);
	ASSEMBLER_BIND_LABEL(ASSEMBLY, LOOP_TOP);
	DOT_WITH_WEIGHTS(
		ASSEMBLY, 0, 1, 2, INPUT_BASE, INPUT_DISPLACEMENT, R8, 0, COLUMN_COUNT
	);

	if (SHOULD_ACCUMULATE)
		SCALAR_MATH_MEMORY(
			ASSEMBLY, OPCODE_ADD, 0, 0,
			MEMORY_INDEXED(OUTPUT_BASE, RCX, 4, OUTPUT_DISPLACEMENT)
		);

	SCALAR_STORE(
		ASSEMBLY, MEMORY_INDEXED(OUTPUT_BASE, RCX, 4, OUTPUT_DISPLACEMENT), 0
	);
	ADD_IMMEDIATE(
		ASSEMBLY, R8, HALF_WEIGHTS ? COLUMN_COUNT * 2 : COLUMN_COUNT * 4
	);
	ADD_IMMEDIATE(ASSEMBLY, RCX, 1);
	COMPARE_IMMEDIATE(ASSEMBLY, RCX, ROW_COUNT);
	BRANCH_TO_LABEL(ASSEMBLY, CC_L, LOOP_TOP);
}

static void
	GENERATE_RECIPE(
		ASSEMBLER *ASSEMBLY, WEB *NEURAL_WEB, NEURON *ORGAN, int KERNEL_ROLE
	)
{
	RECIPE_KERNEL	RECIPE_STATE = {
		NEURAL_WEB,
		&NEURAL_WEB->RECIPES[ORGAN->KIND_DETAIL - ORGAN_RECIPE_BASE],
		ORGAN->AREA_INDEX, 0
	};
	RECIPE			*ACTIVE_RECIPE = RECIPE_STATE.CURRENT_RECIPE;

	RECIPE_STATE.ROW_STRIDE = (int32_t)ACTIVE_RECIPE->VALUE_STRIDE;

	int	MODEL_WIDTH = NEURAL_WEB->CONFIGURATION.DIMENSION;

	if (KERNEL_ROLE == ROLE_FORWARD)
	{
		int	OPERATION_INDEX;

		for (
			OPERATION_INDEX = 1;
			OPERATION_INDEX < ACTIVE_RECIPE->OPERATION_COUNT;
			OPERATION_INDEX++
		)
		{
			RECIPE_OPERATION	*OPERATION =
				&ACTIVE_RECIPE->OPERATIONS[OPERATION_INDEX];
			int32_t				PARAMETER_OFFSET;

			if (OPERATION->PARAMETER_INDEX >= 0)
				PARAMETER_OFFSET =
					(int32_t)(ACTIVE_RECIPE
						->PARAMETERS[OPERATION->PARAMETER_INDEX]
						.OFFSET *
						4);
			else
				PARAMETER_OFFSET = 0;

			TIME_LOOP	ROW_LOOP = BEGIN_TIME_LOOP(ASSEMBLY, 1);

			RECIPE_ROW_POINTERS(ASSEMBLY, &RECIPE_STATE);

			int		FIRST_BASE = 0;
			int		SECOND_BASE = 0;
			int		RESULT_BASE = 0;
			int32_t	FIRST_OFFSET = 0;
			int32_t	SECOND_OFFSET = 0;
			int32_t	RESULT_OFFSET = 0;

			if (OPERATION->FIRST_INPUT >= 0)
				RECIPE_LOCATE(
					&RECIPE_STATE, OPERATION->FIRST_INPUT, 0, &FIRST_BASE,
					&FIRST_OFFSET
				);

			if (OPERATION->SECOND_INPUT >= 0)
				RECIPE_LOCATE(
					&RECIPE_STATE, OPERATION->SECOND_INPUT, 0, &SECOND_BASE,
					&SECOND_OFFSET
				);

			if (OPERATION->OPERATION != RECIPE_OUTPUT)
				RECIPE_LOCATE(
					&RECIPE_STATE, OPERATION_INDEX, 0, &RESULT_BASE,
					&RESULT_OFFSET
				);

			ELEMENT_LAYOUT	ELEMENT_DATA = {
				&RECIPE_STATE, OPERATION_INDEX, PARAMETER_OFFSET
			};

			switch (OPERATION->OPERATION)
			{
				case RECIPE_MATRIX_VECTOR:
				{
					EMIT_MATRIX_VECTOR(
						ASSEMBLY, &RECIPE_STATE, OPERATION->LENGTH,
						ACTIVE_RECIPE->PARAMETERS[OPERATION->PARAMETER_INDEX]
							.COLUMNS,
						PARAMETER_OFFSET, FIRST_BASE, FIRST_OFFSET, RESULT_BASE,
						RESULT_OFFSET, 0
					);
				}
				break ;
				case RECIPE_MATRIX_TRANSPOSED:
				{
					RECIPE_TRANSPOSED_VECTOR(
						ASSEMBLY, &RECIPE_STATE, OPERATION->LENGTH,
						ACTIVE_RECIPE->PARAMETERS[OPERATION->PARAMETER_INDEX]
							.ROWS,
						PARAMETER_OFFSET, FIRST_BASE, FIRST_OFFSET,
						OPERATION_INDEX, 0,
						OPERATION->LOCATION == LOCATION_RESIDUAL
					);
				}
				break ;
				case RECIPE_DOT_PRODUCT:
				{
					DOT_PRODUCT(
						ASSEMBLY, 0, 1, 2, FIRST_BASE, FIRST_OFFSET,
						SECOND_BASE, SECOND_OFFSET,
						ACTIVE_RECIPE->OPERATIONS[OPERATION->FIRST_INPUT].LENGTH
					);
					SCALAR_STORE(
						ASSEMBLY, MEMORY_AT(RESULT_BASE, RESULT_OFFSET), 0
					);
				}
				break ;
				case RECIPE_SUM:
				{
					SUM_LAYOUT	SUM_DATA = { &RECIPE_STATE, OPERATION_INDEX };

					ZERO_VECTOR(ASSEMBLY, 0);
					FOR_EACH_CHUNK(
						ASSEMBLY,
						ACTIVE_RECIPE->OPERATIONS[OPERATION->FIRST_INPUT]
							.LENGTH,
						SUM_CHUNK, &SUM_DATA
					);
					HORIZONTAL_SUM(ASSEMBLY, 0, 1);
					SCALAR_STORE(
						ASSEMBLY, MEMORY_AT(RESULT_BASE, RESULT_OFFSET), 0
					);
				}
				break ;
				case RECIPE_SOFTMAX:
				{
					FOR_EACH_CHUNK(
						ASSEMBLY, OPERATION->LENGTH, ELEMENT_FORWARD_CHUNK,
						&ELEMENT_DATA
					);
					LOAD_ADDRESS(
						ASSEMBLY, R10, MEMORY_AT(RESULT_BASE, RESULT_OFFSET)
					);
					MOVE_IMMEDIATE(ASSEMBLY, RCX, OPERATION->LENGTH);
					SOFTMAX_ROW(ASSEMBLY, R10, RCX);
				}
				break ;
				case RECIPE_OUTPUT:
				{
					if (
						ACTIVE_RECIPE->OPERATIONS[OPERATION->FIRST_INPUT]
								.LOCATION != LOCATION_RESIDUAL
					)
						FOR_EACH_CHUNK(
							ASSEMBLY, MODEL_WIDTH, ELEMENT_FORWARD_CHUNK,
							&ELEMENT_DATA
						);
				}
				break ;
				case RECIPE_SCALE:
				{
					BROADCAST_MEMORY(
						ASSEMBLY, 1, 6, MEMORY_AT(SECOND_BASE, SECOND_OFFSET)
					);
					FOR_EACH_CHUNK(
						ASSEMBLY, OPERATION->LENGTH, ELEMENT_FORWARD_CHUNK,
						&ELEMENT_DATA
					);
				}
				break ;
				default:
				{
					FOR_EACH_CHUNK(
						ASSEMBLY, OPERATION->LENGTH, ELEMENT_FORWARD_CHUNK,
						&ELEMENT_DATA
					);
				}
				break ;
			}

			END_TIME_LOOP(ASSEMBLY, ROW_LOOP);
		}

		JUMP_TO_REGISTER(ASSEMBLY, RBP);
		return ;
	}

	{
		TIME_LOOP	ROW_LOOP = BEGIN_TIME_LOOP(ASSEMBLY, 0);

		RECIPE_ROW_POINTERS(ASSEMBLY, &RECIPE_STATE);
		ZERO_VECTOR(ASSEMBLY, 15);
		FOR_EACH_CHUNK(
			ASSEMBLY, RECIPE_STATE.ROW_STRIDE / 4, CLEAR_GRADIENT_CHUNK, NULL
		);
		END_TIME_LOOP(ASSEMBLY, ROW_LOOP);
	}

	int	OPERATION_INDEX;

	for (
		OPERATION_INDEX = ACTIVE_RECIPE->OPERATION_COUNT - 1;
		OPERATION_INDEX > 0;
		OPERATION_INDEX--
	)
	{
		RECIPE_OPERATION	*OPERATION =
			&ACTIVE_RECIPE->OPERATIONS[OPERATION_INDEX];
		int32_t				PARAMETER_OFFSET;

		if (OPERATION->PARAMETER_INDEX >= 0)
			PARAMETER_OFFSET =
				(int32_t)(ACTIVE_RECIPE->PARAMETERS[OPERATION->PARAMETER_INDEX]
					.OFFSET *
					4);
		else
			PARAMETER_OFFSET = 0;

		int		FIRST_BASE = 0;
		int		SECOND_BASE = 0;
		int		RESULT_BASE = 0;
		int		FIRST_GRADIENT_BASE = 0;
		int		SECOND_GRADIENT_BASE = 0;
		int		RESULT_GRADIENT_BASE = 0;
		int32_t	FIRST_OFFSET = 0;
		int32_t	SECOND_OFFSET = 0;
		int32_t	RESULT_OFFSET = 0;
		int32_t	FIRST_GRADIENT_OFFSET = 0;
		int32_t	SECOND_GRADIENT_OFFSET = 0;
		int32_t	RESULT_GRADIENT_OFFSET = 0;

		if (OPERATION->FIRST_INPUT >= 0)
		{
			RECIPE_LOCATE(
				&RECIPE_STATE, OPERATION->FIRST_INPUT, 0, &FIRST_BASE,
				&FIRST_OFFSET
			);
			RECIPE_LOCATE(
				&RECIPE_STATE, OPERATION->FIRST_INPUT, 1, &FIRST_GRADIENT_BASE,
				&FIRST_GRADIENT_OFFSET
			);
		}

		if (OPERATION->SECOND_INPUT >= 0)
		{
			RECIPE_LOCATE(
				&RECIPE_STATE, OPERATION->SECOND_INPUT, 0, &SECOND_BASE,
				&SECOND_OFFSET
			);
			RECIPE_LOCATE(
				&RECIPE_STATE, OPERATION->SECOND_INPUT, 1,
				&SECOND_GRADIENT_BASE, &SECOND_GRADIENT_OFFSET
			);
		}

		if (OPERATION->OPERATION != RECIPE_OUTPUT)
		{
			RECIPE_LOCATE(
				&RECIPE_STATE, OPERATION_INDEX, 0, &RESULT_BASE, &RESULT_OFFSET
			);
			RECIPE_LOCATE(
				&RECIPE_STATE, OPERATION_INDEX, 1, &RESULT_GRADIENT_BASE,
				&RESULT_GRADIENT_OFFSET
			);
		}

		if (
			OPERATION->OPERATION == RECIPE_OUTPUT &&
			ACTIVE_RECIPE->OPERATIONS[OPERATION->FIRST_INPUT].LOCATION ==
				LOCATION_RESIDUAL
		)
			continue ;

		ELEMENT_LAYOUT	ELEMENT_DATA = {
			&RECIPE_STATE, OPERATION_INDEX, PARAMETER_OFFSET
		};
		TIME_LOOP		ROW_LOOP = BEGIN_TIME_LOOP(ASSEMBLY, 0);

		RECIPE_ROW_POINTERS(ASSEMBLY, &RECIPE_STATE);

		switch (OPERATION->OPERATION)
		{
			case RECIPE_MATRIX_VECTOR:
			{
				RECIPE_TRANSPOSED_VECTOR(
					ASSEMBLY, &RECIPE_STATE,
					ACTIVE_RECIPE->PARAMETERS[OPERATION->PARAMETER_INDEX]
						.COLUMNS,
					OPERATION->LENGTH, PARAMETER_OFFSET, RESULT_GRADIENT_BASE,
					RESULT_GRADIENT_OFFSET, OPERATION->FIRST_INPUT, 1, 1
				);
			}
			break ;
			case RECIPE_MATRIX_TRANSPOSED:
			{
				EMIT_MATRIX_VECTOR(
					ASSEMBLY, &RECIPE_STATE,
					ACTIVE_RECIPE->PARAMETERS[OPERATION->PARAMETER_INDEX].ROWS,
					OPERATION->LENGTH, PARAMETER_OFFSET, RESULT_GRADIENT_BASE,
					RESULT_GRADIENT_OFFSET, FIRST_GRADIENT_BASE,
					FIRST_GRADIENT_OFFSET, 1
				);
			}
			break ;
			case RECIPE_DOT_PRODUCT:
			case RECIPE_SUM:
			{
				BROADCAST_MEMORY(
					ASSEMBLY, 1, 6,
					MEMORY_AT(RESULT_GRADIENT_BASE, RESULT_GRADIENT_OFFSET)
				);
				FOR_EACH_CHUNK(
					ASSEMBLY,
					ACTIVE_RECIPE->OPERATIONS[OPERATION->FIRST_INPUT].LENGTH,
					ELEMENT_BACKWARD_CHUNK, &ELEMENT_DATA
				);
			}
			break ;
			case RECIPE_SCALE:
			{
				BROADCAST_MEMORY(
					ASSEMBLY, 1, 6, MEMORY_AT(SECOND_BASE, SECOND_OFFSET)
				);
				ZERO_VECTOR(ASSEMBLY, 7);
				FOR_EACH_CHUNK(
					ASSEMBLY, OPERATION->LENGTH, ELEMENT_BACKWARD_CHUNK,
					&ELEMENT_DATA
				);
				HORIZONTAL_SUM(ASSEMBLY, 7, 1);
				SCALAR_MATH_MEMORY(
					ASSEMBLY, OPCODE_ADD, 7, 7,
					MEMORY_AT(SECOND_GRADIENT_BASE, SECOND_GRADIENT_OFFSET)
				);
				SCALAR_STORE(
					ASSEMBLY,
					MEMORY_AT(SECOND_GRADIENT_BASE, SECOND_GRADIENT_OFFSET), 7
				);
			}
			break ;
			case RECIPE_SOFTMAX:
			{
				DOT_PRODUCT(
					ASSEMBLY, 6, 1, 2, RESULT_GRADIENT_BASE,
					RESULT_GRADIENT_OFFSET, RESULT_BASE, RESULT_OFFSET,
					OPERATION->LENGTH
				);
				BROADCAST_REGISTER(ASSEMBLY, 1, 6, 6);
				FOR_EACH_CHUNK(
					ASSEMBLY, OPERATION->LENGTH, ELEMENT_BACKWARD_CHUNK,
					&ELEMENT_DATA
				);
			}
			break ;
			case RECIPE_OUTPUT:
			{
				FOR_EACH_CHUNK(
					ASSEMBLY, MODEL_WIDTH, ELEMENT_BACKWARD_CHUNK, &ELEMENT_DATA
				);
			}
			break ;
			default:
			{
				FOR_EACH_CHUNK(
					ASSEMBLY, OPERATION->LENGTH, ELEMENT_BACKWARD_CHUNK,
					&ELEMENT_DATA
				);
			}
			break ;
		}

		END_TIME_LOOP(ASSEMBLY, ROW_LOOP);

		int32_t	GRADIENT_PLANE = (int32_t)PARAMETER_PLANE;

		if (OPERATION->OPERATION == RECIPE_MATRIX_VECTOR)
		{
			OUTER_INPUT_FROM_NEURON =
				ACTIVE_RECIPE->OPERATIONS[OPERATION->FIRST_INPUT].LOCATION ==
				LOCATION_OWN;
			ACCUMULATE_OUTER_PRODUCT(
				ASSEMBLY, OPERATION->LENGTH,
				ACTIVE_RECIPE->PARAMETERS[OPERATION->PARAMETER_INDEX].COLUMNS,
				RESULT_GRADIENT_OFFSET, RECIPE_STATE.ROW_STRIDE, 1,
				FIRST_OFFSET,
				OUTER_INPUT_FROM_NEURON ? RECIPE_STATE.ROW_STRIDE
										: MODEL_WIDTH * 4,
				GRADIENT_PLANE + PARAMETER_OFFSET,
				ACTIVE_RECIPE->PARAMETERS[OPERATION->PARAMETER_INDEX].COLUMNS *
					4
			);
			OUTER_INPUT_FROM_NEURON = 0;
		}
		else if (OPERATION->OPERATION == RECIPE_MATRIX_TRANSPOSED)
		{
			int	INPUT_IS_OWNED =
				ACTIVE_RECIPE->OPERATIONS[OPERATION->FIRST_INPUT].LOCATION ==
				LOCATION_OWN;

			OUTER_INPUT_FROM_NEURON = OPERATION->LOCATION == LOCATION_OWN;
			ACCUMULATE_OUTER_PRODUCT(
				ASSEMBLY,
				ACTIVE_RECIPE->PARAMETERS[OPERATION->PARAMETER_INDEX].ROWS,
				OPERATION->LENGTH, FIRST_OFFSET,
				INPUT_IS_OWNED ? RECIPE_STATE.ROW_STRIDE : MODEL_WIDTH * 4,
				INPUT_IS_OWNED, RESULT_GRADIENT_OFFSET,
				OUTER_INPUT_FROM_NEURON ? RECIPE_STATE.ROW_STRIDE
										: MODEL_WIDTH * 4,
				GRADIENT_PLANE + PARAMETER_OFFSET, OPERATION->LENGTH * 4
			);
			OUTER_INPUT_FROM_NEURON = 0;
		}
	}

	JUMP_TO_REGISTER(ASSEMBLY, RBP);
}
